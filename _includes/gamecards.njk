{#- Nunjucks' selectattr/sort can't read nested `data.featured`, so order by index. #}
<div class="gamecards">
{%- for rank in range(1, collections.games | length + 1) %}
{%- for post in collections.games %}
{%- if post.data.featured == rank %}
	<article class="gamecard">
		<div class="gamecard-thumb">
			{%- if post.data.thumbnail %}
			{% image post.data.thumbnail, post.data.title + " screenshot", [480, 960] %}
			{%- else %}
			<img src="https://img.youtube.com/vi/{{ post.data.youtubeId }}/hqdefault.jpg" width="480" height="360" loading="lazy" decoding="async" alt="{{ post.data.title }} gameplay still">
			{%- endif %}
		</div>
		<h3 class="gamecard-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
		<p class="gamecard-tagline">{{ post.data.tagline }}</p>
		<p class="gamecard-meta">{{ post.data.role }}{% if post.data.platform %} · {{ post.data.platform }}{% endif %}</p>
	</article>
{%- endif %}
{%- endfor %}
{%- endfor %}
</div>
